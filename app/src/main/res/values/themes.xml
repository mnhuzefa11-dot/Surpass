<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Surpass" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/surpass_green</item>
        <item name="android:colorPrimaryDark">@color/surpass_green_dark</item>
        <item name="android:colorAccent">@color/surpass_green</item>
        <item name="android:statusBarColor">@color/surpass_green_dark</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <style name="Theme.Surpass.Overlay" parent="Theme.Surpass">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/surpass_green_dark</item>
    </style>
</resources>
